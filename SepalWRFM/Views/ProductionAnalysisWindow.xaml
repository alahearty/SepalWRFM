<syncfusion:ChromelessWindow x:Class="SepalWRFM.Views.ProductionAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Production Analysis" 
        Height="800" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        syncfusion:SfSkinManager.VisualStyle="MaterialLight"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        UseNativeChrome="True">
    
    <Grid Background="{DynamicResource MainBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Custom Ribbon-like Toolbar with Syncfusion Styling -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Quick Access Toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource AppCardBackground}" Height="32" Padding="8,4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Save"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>
                        <Button Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Undo"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <materialDesign:PackIcon Kind="Undo" Width="16" Height="16" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>
                        <Button Width="24" Height="24" Padding="0" Margin="0,0,8,0" ToolTip="Redo"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <materialDesign:PackIcon Kind="Redo" Width="16" Height="16" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>
                        <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="0,4,8,4"/>
                    </StackPanel>
                </Border>
                
                <!-- Ribbon Tabs -->
                <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                        
                        <!-- Ribbon Button Style -->
                        <Style x:Key="RibbonButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedBackground}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorder}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Resources>
                    
                    <TabItem Header="Home" IsSelected="True">
                        <Border Background="{DynamicResource AppCardBackground}" Padding="16,12">
                            <StackPanel>
                                <!-- File Group -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="File" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button ToolTip="New" Style="{StaticResource RibbonButtonStyle}">
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MinWidth="60">
                                                    <materialDesign:PackIcon Kind="FilePlus" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="New" FontSize="10" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button ToolTip="Open" Style="{StaticResource RibbonButtonStyle}">
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MinWidth="60">
                                                    <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Open" FontSize="10" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button ToolTip="Save" Style="{StaticResource RibbonButtonStyle}">
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MinWidth="60">
                                                    <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Save" FontSize="10" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Edit Group -->
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Edit" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button ToolTip="Cut" Style="{StaticResource RibbonButtonStyle}">
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MinWidth="60">
                                                    <materialDesign:PackIcon Kind="ContentCut" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Cut" FontSize="10" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button ToolTip="Copy" Style="{StaticResource RibbonButtonStyle}">
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MinWidth="60">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Copy" FontSize="10" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button ToolTip="Paste" Style="{StaticResource RibbonButtonStyle}">
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MinWidth="60">
                                                    <materialDesign:PackIcon Kind="ContentPaste" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Paste" FontSize="10" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Analysis Group -->
                                    <StackPanel>
                                        <TextBlock Text="Analysis" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button ToolTip="Run Analysis" Style="{StaticResource RibbonButtonStyle}">
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MinWidth="70">
                                                    <materialDesign:PackIcon Kind="Play" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Run" FontSize="10" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button ToolTip="Export" Style="{StaticResource RibbonButtonStyle}">
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MinWidth="60">
                                                    <materialDesign:PackIcon Kind="Export" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Export" FontSize="10" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </TabItem>
                    
                    <TabItem Header="View">
                        <Border Background="{DynamicResource AppCardBackground}" Padding="16,12">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Layout" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                    <Button ToolTip="Reset Layout" Style="{StaticResource RibbonButtonStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MinWidth="60">
                                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Reset" FontSize="10" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Tools" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                    <Button x:Name="CopilotButton" ToolTip="Toggle Copilot" Style="{StaticResource RibbonButtonStyle}" HorizontalAlignment="Left" Click="CopilotButton_Click">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MinWidth="70">
                                            <materialDesign:PackIcon Kind="Robot" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Copilot" FontSize="10" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
        
        <!-- Syncfusion Docking Manager -->
        <syncfusion:DockingManager Grid.Row="1" 
                                   x:Name="dockingManager"
                                   DockFill="True" 
                                   UseDocumentContainer="True"
                                   Background="{DynamicResource MainBackground}">
            
            <!-- Left Dock Window (Properties) -->
            <ContentControl syncfusion:DockingManager.Header="Properties"
                           syncfusion:DockingManager.State="Dock"
                           syncfusion:DockingManager.SideInDockedMode="Left"
                           syncfusion:DockingManager.CanClose="True"
                           syncfusion:DockingManager.CanFloat="True"
                           syncfusion:DockingManager.CanAutoHide="True"
                           syncfusion:DockingManager.CanDock="True"
                           Width="250"
                           MinWidth="200">
                <Border Background="{DynamicResource AppCardBackground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" Padding="12,8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Properties" 
                                       FontSize="13" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12">
                                <TextBlock Text="Properties Panel" 
                                           FontSize="14" 
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </ContentControl>

            <!-- Right Dock Window (Tools) -->
            <ContentControl syncfusion:DockingManager.Header="Tools"
                           syncfusion:DockingManager.State="Dock"
                           syncfusion:DockingManager.SideInDockedMode="Right"
                           syncfusion:DockingManager.CanClose="True"
                           syncfusion:DockingManager.CanFloat="True"
                           syncfusion:DockingManager.CanAutoHide="True"
                           syncfusion:DockingManager.CanDock="True"
                           Width="250"
                           MinWidth="200"
                           x:Name="ToolsPanel">
                <Border Background="{DynamicResource AppCardBackground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" Padding="12,8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Tools" 
                                       FontSize="13" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12">
                                <TextBlock Text="Tools Panel" 
                                           FontSize="14" 
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </ContentControl>

            <!-- Right Dock Window (Copilot) -->
            <ContentControl syncfusion:DockingManager.Header="Copilot"
                           syncfusion:DockingManager.State="Hidden"
                           syncfusion:DockingManager.SideInDockedMode="Right"
                           syncfusion:DockingManager.CanClose="True"
                           syncfusion:DockingManager.CanFloat="True"
                           syncfusion:DockingManager.CanAutoHide="False"
                           syncfusion:DockingManager.CanDock="True"
                           Width="380"
                           MinWidth="300"
                           x:Name="CopilotPanel">
                <ContentControl prism:RegionManager.RegionName="CopilotRegion"/>
            </ContentControl>

            <!-- Center Document Window (Workspace) -->
            <ContentControl syncfusion:DockingManager.Header="Workspace"
                           syncfusion:DockingManager.State="Document"
                           syncfusion:DockingManager.CanClose="False"
                           x:Name="WorkspaceContent">
                <Grid Background="{DynamicResource SidebarBackground}">
                    <ContentControl prism:RegionManager.RegionName="ProductionAnalysisWorkspaceRegion"/>
                </Grid>
            </ContentControl>
        </syncfusion:DockingManager>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Height="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left side status items -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Ready" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextSecondary}" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="No items selected" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Right side status items -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="100%" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextSecondary}" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="StatusBarTime" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</syncfusion:ChromelessWindow>

<UserControl x:Class="SepalWRFM.Modules.ModuleName.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:SepalWRFM.Modules.ModuleName.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Theme Colors - Same as AppsLandingView -->
        <SolidColorBrush x:Key="SidebarBackground" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="MainBackground" Color="#121212"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="HoverBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="SelectedBackground" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="PrimaryButton" Color="#6264A7"/>
        <SolidColorBrush x:Key="SidebarHover" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="SidebarSelected" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="SelectedIndicator" Color="#0078D4"/>
        <SolidColorBrush x:Key="SidebarBorder" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="SidebarTextSecondary" Color="#A19F9D"/>
        <SolidColorBrush x:Key="AvatarColor" Color="#6264A7"/>
        <SolidColorBrush x:Key="CardHoverBorder" Color="#4D4D4D"/>
        <SolidColorBrush x:Key="AppCardBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="AppCardBorder" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="SettingsNavBackground" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="SettingsContentBackground" Color="#252423"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MainBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Pane -->
        <Border Grid.Column="0" 
                Background="{DynamicResource SettingsNavBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="0">
                <Button Background="Transparent" 
                        BorderThickness="0" 
                        Padding="16,16"
                        HorizontalContentAlignment="Left"
                        Cursor="Hand"
                        Command="{Binding NavigateToSectionCommand}" 
                        CommandParameter="General">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Border Background="{DynamicResource SelectedIndicator}" 
                                                        Width="3" 
                                                        HorizontalAlignment="Left" 
                                                        Margin="0"
                                                        Visibility="{Binding IsGeneralSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cog" 
                                                 Width="20" Height="20" 
                                                 VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGeneralSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SelectedIndicator}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Text="General" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Margin="12,0,0,0" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Background="Transparent" 
                        BorderThickness="0" 
                        Padding="16,16"
                        HorizontalContentAlignment="Left"
                        Cursor="Hand"
                        Command="{Binding NavigateToSectionCommand}" 
                        CommandParameter="Privacy">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountLock" 
                                                 Foreground="{DynamicResource TextPrimary}" 
                                                 Width="20" Height="20" 
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Privacy" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Margin="12,0,0,0" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Background="Transparent" 
                        BorderThickness="0" 
                        Padding="16,16"
                        HorizontalContentAlignment="Left"
                        Cursor="Hand"
                        Command="{Binding NavigateToSectionCommand}" 
                        CommandParameter="Notifications">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Bell" 
                                                 Foreground="{DynamicResource TextPrimary}" 
                                                 Width="20" Height="20" 
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Notifications" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Margin="12,0,0,0" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Right Content Area -->
        <Grid Grid.Column="1" Background="{DynamicResource SettingsContentBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Close Button -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource SettingsContentBackground}" 
                    BorderBrush="{DynamicResource BorderColor}" 
                    BorderThickness="0,0,0,1" 
                    Padding="32,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="General" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimary}"/>
                    <Button Grid.Column="1" 
                           Background="Transparent" 
                           BorderThickness="0" 
                           Padding="8"
                           Cursor="Hand"
                           Command="{Binding CloseSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="Close" 
                                                 Foreground="{DynamicResource TextPrimary}" 
                                                 Width="24" Height="24"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,32">
                    <!-- About Section -->
                    <TextBlock Text="About Enterprise Suite" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimary}" 
                               Margin="0,0,0,16"/>
                    <Border Background="{DynamicResource AppCardBackground}" 
                            BorderBrush="{DynamicResource BorderColor}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16" 
                            Margin="0,0,0,32"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
                                       Text="About Enterprise Suite" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource TextPrimary}" 
                                       VerticalAlignment="Center"/>
                            <materialDesign:PackIcon Grid.Column="1" 
                                                     Kind="ChevronRight" 
                                                     Foreground="{DynamicResource TextSecondary}" 
                                                     Width="20" Height="20" 
                                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Appearance Section -->
                    <TextBlock Text="Appearance" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimary}" 
                               Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                        <!-- Use system settings -->
                        <Border Background="{DynamicResource AppCardBackground}" 
                                BorderBrush="{DynamicResource BorderColor}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16" 
                                Margin="0,0,16,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="ThemeOption_MouseLeftButtonDown"
                                Tag="System"
                                Width="140"
                                Height="140">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" 
                                        Background="{DynamicResource AppCardBackground}" 
                                        BorderBrush="{DynamicResource BorderColor}" 
                                        BorderThickness="1" 
                                        CornerRadius="4"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource MainBackground}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource SidebarBackground}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" 
                                           Text="Use system settings" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextPrimary}" 
                                           HorizontalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="CheckCircle" 
                                                         Width="20" Height="20" 
                                                         HorizontalAlignment="Right" 
                                                         VerticalAlignment="Top" 
                                                         Margin="0,0,0,0"
                                                         Foreground="{DynamicResource SelectedIndicator}"
                                                         Visibility="{Binding IsSystemTheme, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Border>

                        <!-- Light theme -->
                        <Border Background="{DynamicResource AppCardBackground}" 
                                BorderBrush="{DynamicResource BorderColor}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16" 
                                Margin="0,0,16,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="ThemeOption_MouseLeftButtonDown"
                                Tag="Light"
                                Width="140"
                                Height="140">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" 
                                        Background="#FFFFFF" 
                                        BorderBrush="{DynamicResource BorderColor}" 
                                        BorderThickness="1" 
                                        CornerRadius="4"
                                        Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" 
                                           Text="Light" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextPrimary}" 
                                           HorizontalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="CheckCircle" 
                                                         Width="20" Height="20" 
                                                         HorizontalAlignment="Right" 
                                                         VerticalAlignment="Top" 
                                                         Margin="0,0,0,0"
                                                         Foreground="{DynamicResource SelectedIndicator}"
                                                         Visibility="{Binding IsLightTheme, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Border>

                        <!-- Dark theme -->
                        <Border Background="{DynamicResource AppCardBackground}" 
                                BorderBrush="{DynamicResource BorderColor}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16" 
                                Margin="0,0,0,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="ThemeOption_MouseLeftButtonDown"
                                Tag="Dark"
                                Width="140"
                                Height="140">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" 
                                        Background="#1E1E1E" 
                                        BorderBrush="{DynamicResource BorderColor}" 
                                        BorderThickness="1" 
                                        CornerRadius="4"
                                        Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" 
                                           Text="Dark" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextPrimary}" 
                                           HorizontalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="CheckCircle" 
                                                         Width="20" Height="20" 
                                                         HorizontalAlignment="Right" 
                                                         VerticalAlignment="Top" 
                                                         Margin="0,0,0,0"
                                                         Foreground="{DynamicResource SelectedIndicator}"
                                                         Visibility="{Binding IsDarkTheme, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Languages and regions -->
                    <TextBlock Text="Languages and regions" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimary}" 
                               Margin="0,0,0,16"/>
                    <TextBlock Text="Change your language in your browser settings." 
                               FontSize="14" 
                               Foreground="{DynamicResource TextSecondary}" 
                               Margin="0,0,0,32"/>

                    <!-- Terms of use -->
                    <TextBlock Text="Terms of use" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimary}" 
                               Margin="0,0,0,16"/>
                    <Border Background="{DynamicResource AppCardBackground}" 
                            BorderBrush="{DynamicResource BorderColor}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16" 
                            Margin="0,0,0,32"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
                                       Text="Terms of use" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource TextPrimary}" 
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="View" 
                                           FontSize="14" 
                                           Foreground="{DynamicResource SelectedIndicator}" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <materialDesign:PackIcon Kind="OpenInNew" 
                                                         Foreground="{DynamicResource SelectedIndicator}" 
                                                         Width="16" Height="16" 
                                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Third party notice -->
                    <TextBlock Text="Third party notice" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimary}" 
                               Margin="0,0,0,16"/>
                    <Border Background="{DynamicResource AppCardBackground}" 
                            BorderBrush="{DynamicResource BorderColor}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16" 
                            Margin="0,0,0,0"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
                                       Text="Third party notice" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource TextPrimary}" 
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="View" 
                                           FontSize="14" 
                                           Foreground="{DynamicResource SelectedIndicator}" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <materialDesign:PackIcon Kind="OpenInNew" 
                                                         Foreground="{DynamicResource SelectedIndicator}" 
                                                         Width="16" Height="16" 
                                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

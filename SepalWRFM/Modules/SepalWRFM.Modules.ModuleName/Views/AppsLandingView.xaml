<UserControl x:Class="SepalWRFM.Modules.ModuleName.Views.AppsLandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:SepalWRFM.Core.Converters;assembly=SepalWRFM.Core"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <converters:IconKindConverter x:Key="IconKindConverter"/>
        <converters:BooleanToWidthConverter x:Key="BooleanToWidthConverter"/>
        <converters:BooleanToHeightConverter x:Key="BooleanToHeightConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BooleanToInverseVisibilityConverter x:Key="BooleanToInverseVisibilityConverter"/>
        <converters:BooleanToColumnWidthConverter x:Key="BooleanToColumnWidthConverter"/>
        
        <!-- Theme Color Converters -->
        <converters:ThemeColorConverter x:Key="SidebarBackgroundConverter" 
                                        DarkColor="#1F1F1F" LightColor="#F3F2F1"/>
        <converters:ThemeColorConverter x:Key="MainBackgroundConverter" 
                                        DarkColor="#121212" LightColor="#FFFFFF"/>
        <converters:ThemeColorConverter x:Key="TextPrimaryConverter" 
                                        DarkColor="#FFFFFF" LightColor="#323130"/>
        <converters:ThemeColorConverter x:Key="TextSecondaryConverter" 
                                        DarkColor="#B0B0B0" LightColor="#605E5C"/>
        <converters:ThemeColorConverter x:Key="HoverBackgroundConverter" 
                                        DarkColor="#2D2D2D" LightColor="#EDEBE9"/>
        <converters:ThemeColorConverter x:Key="SelectedBackgroundConverter" 
                                        DarkColor="#3D3D3D" LightColor="#E1DFDD"/>
        <converters:ThemeColorConverter x:Key="BorderColorConverter" 
                                        DarkColor="#3D3D3D" LightColor="#EDEBE9"/>
        <converters:ThemeColorConverter x:Key="SidebarHoverConverter" 
                                        DarkColor="#2D2D2D" LightColor="#E1DFDD"/>
        <converters:ThemeColorConverter x:Key="SidebarSelectedConverter" 
                                        DarkColor="#3D3D3D" LightColor="#D2D0CE"/>
        <converters:ThemeColorConverter x:Key="SidebarBorderConverter" 
                                        DarkColor="#3D3D3D" LightColor="#C8C6C4"/>
        <converters:ThemeColorConverter x:Key="SidebarTextSecondaryConverter" 
                                        DarkColor="#A19F9D" LightColor="#605E5C"/>
        <converters:ThemeColorConverter x:Key="CardHoverBorderConverter" 
                                        DarkColor="#4D4D4D" LightColor="#C8C6C4"/>
        <converters:ThemeColorConverter x:Key="AppCardBackgroundConverter" 
                                        DarkColor="#1E1E1E" LightColor="#FFFFFF"/>
        <converters:ThemeColorConverter x:Key="AppCardBorderConverter" 
                                        DarkColor="#3D3D3D" LightColor="#EDEBE9"/>
        
        <!-- Theme Colors - Updated programmatically when theme changes -->
        <SolidColorBrush x:Key="SidebarBackground" Color="#FAF9F8"/>
        <SolidColorBrush x:Key="MainBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#323130"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8A8886"/>
        <SolidColorBrush x:Key="HoverBackground" Color="#F3F2F1"/>
        <SolidColorBrush x:Key="SelectedBackground" Color="#EDEBE9"/>
        <SolidColorBrush x:Key="BorderColor" Color="#EDEBE9"/>
        <SolidColorBrush x:Key="PrimaryButton" Color="#6264A7"/>
        <SolidColorBrush x:Key="SidebarHover" Color="#F3F2F1"/>
        <SolidColorBrush x:Key="SidebarSelected" Color="#EDEBE9"/>
        <SolidColorBrush x:Key="SelectedIndicator" Color="#0078D4"/>
        <SolidColorBrush x:Key="SidebarBorder" Color="#E1DFDD"/>
        <SolidColorBrush x:Key="SidebarTextSecondary" Color="#605E5C"/>
        <SolidColorBrush x:Key="AvatarColor" Color="#6264A7"/>
        <SolidColorBrush x:Key="CardHoverBorder" Color="#C8C6C4"/>
        <SolidColorBrush x:Key="AppCardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppCardBorder" Color="#EDEBE9"/>
        
        <!-- Styles -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectedSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SidebarSelected}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{StaticResource SelectedIndicator}" Width="3" HorizontalAlignment="Left" Margin="0"/>
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="4" 
                                    Padding="{TemplateBinding Padding}"
                                    Margin="0,0,0,0">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FeaturedAppCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
            <Setter Property="Margin" Value="0,0,16,16"/>
        </Style>

        <Style x:Key="RegularAppCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="140"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IsSidebarVisible, Converter={StaticResource BooleanToColumnWidthConverter}}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" Visibility="{Binding IsSidebarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toggle Button and Logo Section -->
                <Grid Grid.Row="0" Margin="16,20,16,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                       <TextBlock Text="Enterprise Suite" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="SemiBold" 
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="8" 
                            Cursor="Hand"
                            Command="{Binding ToggleSidebarCommand}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="Menu" Foreground="{DynamicResource TextPrimary}" Width="24" Height="24"/>
                    </Button>
                </Grid>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1" Margin="8,0,8,0">
                    <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,4,0,4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Foreground="{DynamicResource TextPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Search" Margin="12,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SelectedSidebarButtonStyle}" Margin="0,4,0,4" Command="{Binding NavigateCommand}" CommandParameter="Apps">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Apps" Foreground="{DynamicResource TextPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Apps" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextSecondary}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,4,0,4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MessageText" Foreground="{DynamicResource TextPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="User Guides" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextSecondary}"/>
                        </StackPanel>
                    </Button>


                    <TextBlock Text="CONVERSATIONS" Foreground="{DynamicResource SidebarTextSecondary}" FontSize="11" FontWeight="SemiBold" 
                               Margin="12,16,0,8"/>

                    <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,4,0,4" Command="{Binding NavigateCommand}" CommandParameter="Apps">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Apps" Foreground="{DynamicResource TextPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Chat" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextSecondary}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,4,0,4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookOpen" Foreground="{DynamicResource TextPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Tutorials" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextSecondary}"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- User Profile Section -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,1,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="32" Height="32" Fill="{StaticResource AvatarColor}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <materialDesign:PackIcon Kind="Account" 
                                                 Foreground="{DynamicResource TextPrimary}" 
                                                 Width="20" Height="20" 
                                                 Grid.Column="0"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="User Name" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="user@company.com" Foreground="{DynamicResource SidebarTextSecondary}" FontSize="11"/>
                        </StackPanel>
                        <Button x:Name="AccountMenuButton" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="4" Click="AccountMenuButton_Click">
                            <materialDesign:PackIcon Kind="DotsVertical" Foreground="{DynamicResource TextPrimary}" Width="20" Height="20"/>
                        </Button>
                        <Popup x:Name="AccountMenuPopup" 
                               Placement="Bottom" 
                               PlacementTarget="{Binding ElementName=AccountMenuButton}"
                               StaysOpen="False"
                               PopupAnimation="Fade"
                               Closed="AccountMenuPopup_Closed">
                            <Border Background="{DynamicResource MainBackground}" 
                                    BorderBrush="{DynamicResource BorderColor}" 
                                    BorderThickness="1" 
                                    CornerRadius="8"
                                    Padding="8"
                                    MinWidth="200">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" 
                                                      Opacity="0.3" 
                                                      BlurRadius="10" 
                                                      ShadowDepth="3" 
                                                      Direction="315"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button Background="Transparent" 
                                            BorderThickness="0" 
                                            Padding="12,8" 
                                            HorizontalContentAlignment="Left"
                                            Cursor="Hand"
                                            Command="{Binding OpenSettingsCommand}"
                                            Click="SettingsButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Cog" Foreground="{DynamicResource TextPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Settings" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Separator Margin="0,4" Background="{DynamicResource BorderColor}"/>
                                    <Button Background="Transparent" 
                                            BorderThickness="0" 
                                            Padding="12,8" 
                                            HorizontalContentAlignment="Left"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="HelpCircle" Foreground="{DynamicResource TextPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Help" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Background="Transparent" 
                                            BorderThickness="0" 
                                            Padding="12,8" 
                                            HorizontalContentAlignment="Left"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="MessageText" Foreground="{DynamicResource TextPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Feedback" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource MainBackground}">
            <Grid Margin="32,24,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Section -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Apps" FontSize="32" FontWeight="Bold" Margin="18,0,0,0"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    
                </Grid>

                <!-- Featured Apps Section -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Apps}" Margin="0,0,0,32">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding ClickCommand}" CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Margin="0,0,16,16" Cursor="Hand"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Button.Content>
                                    <Border Background="{DynamicResource AppCardBackground}" 
                                            BorderBrush="{DynamicResource AppCardBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="16"
                                            Width="{Binding IsFeatured, Converter={StaticResource BooleanToWidthConverter}}"
                                            Height="{Binding IsFeatured, Converter={StaticResource BooleanToHeightConverter}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                    <!-- Featured App Layout (Outlook) -->
                                    <Grid Visibility="{Binding IsFeatured, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{Binding IconColor}" Width="48" Height="48" 
                                                CornerRadius="8" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="{Binding Icon, Converter={StaticResource IconKindConverter}}" 
                                                                     Foreground="{DynamicResource TextPrimary}" 
                                                                     Width="24" Height="24" 
                                                                     VerticalAlignment="Center" 
                                                                     HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="13" 
                                                       Foreground="{DynamicResource TextSecondary}" 
                                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="4" 
                                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                                Margin="0,-4,-4,0" Click="AppCard_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <materialDesign:PackIcon Kind="DotsVertical" 
                                                                     Foreground="{DynamicResource TextSecondary}" 
                                                                     Width="20" Height="20"/>
                                        </Button>
                                    </Grid>
                                    
                                    <!-- Regular App Layout (Simple Icon + Name) -->
                                    <StackPanel Visibility="{Binding IsFeatured, Converter={StaticResource BooleanToInverseVisibilityConverter}}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Background="{Binding IconColor}" Width="40" Height="40" 
                                                CornerRadius="6" Margin="0,0,0,12" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="{Binding Icon, Converter={StaticResource IconKindConverter}}" 
                                                                     Foreground="{DynamicResource TextPrimary}" 
                                                                     Width="20" Height="20" 
                                                                     VerticalAlignment="Center" 
                                                                     HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button.Content>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- All Apps Link -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" 
                           HorizontalAlignment="Right" 
                           Margin="0,0,0,32"
                           Cursor="Hand">
                    <TextBlock Text="All apps" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryButton}"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <materialDesign:PackIcon Kind="ChevronRight" 
                                              Foreground="{StaticResource PrimaryButton}" 
                                              Width="16" Height="16" 
                                              VerticalAlignment="Center" 
                                              Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Cross Platform Apps Section -->
                <StackPanel Grid.Row="3" Margin="0,0,0,32">
                    <TextBlock Text="Cross Platform Apps" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimary}" 
                               Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding CrossPlatformApps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RegularAppCardStyle}">
                                    <StackPanel>
                                        <Border Background="{Binding IconColor}" Width="40" Height="40" 
                                                CornerRadius="6" Margin="0,0,0,12">
                                            <materialDesign:PackIcon Kind="{Binding Icon, Converter={StaticResource IconKindConverter}}" 
                                                                     Foreground="{DynamicResource TextPrimary}" 
                                                                     Width="20" Height="20" 
                                                                     VerticalAlignment="Center" 
                                                                     HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Work Apps Section -->
                <StackPanel Grid.Row="4">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Get work done" 
                                   FontSize="20" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <Border Grid.Column="1" 
                                Background="Transparent" 
                                BorderThickness="1" 
                                BorderBrush="{StaticResource PrimaryButton}"
                                CornerRadius="4" 
                                Padding="16,8" 
                                Cursor="Hand">
                            <Button Background="Transparent" 
                                    Foreground="{StaticResource PrimaryButton}" 
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand">
                                <TextBlock Text="Other Apps" FontSize="14" FontWeight="SemiBold"/>
                            </Button>
                        </Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding WorkApps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RegularAppCardStyle}">
                                    <StackPanel>
                                        <Border Background="{Binding IconColor}" Width="40" Height="40" 
                                                CornerRadius="6" Margin="0,0,0,12">
                                            <materialDesign:PackIcon Kind="{Binding Icon, Converter={StaticResource IconKindConverter}}" 
                                                                     Foreground="{DynamicResource TextPrimary}" 
                                                                     Width="20" Height="20" 
                                                                     VerticalAlignment="Center" 
                                                                     HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Floating Toggle Button (Always Visible When Sidebar is Hidden) -->
        <Button Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource SidebarBackground}"
                BorderThickness="0"
                Padding="12,16"
                Margin="0"
                Cursor="Hand"
                Command="{Binding ToggleSidebarCommand}"
                Visibility="{Binding IsSidebarVisible, Converter={StaticResource BooleanToInverseVisibilityConverter}}"
                Panel.ZIndex="1000">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="0,0,4,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SidebarHover}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <materialDesign:PackIcon Kind="Menu" Foreground="{DynamicResource TextPrimary}" Width="24" Height="24"/>
        </Button>
    </Grid>
</UserControl>

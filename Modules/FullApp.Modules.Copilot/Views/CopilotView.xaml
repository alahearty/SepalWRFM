<UserControl x:Class="FullApp.Modules.Copilot.Views.CopilotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:FullApp.Modules.Copilot.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="380"
             Background="White">
    <UserControl.Resources>
        <converters:MessageStyleConverter x:Key="MessageStyleConverter"/>
        <converters:MessageForegroundConverter x:Key="MessageForegroundConverter"/>
        <converters:ApprovedToColorConverter x:Key="ApprovedToColorConverter"/>
        <converters:ApprovedToTextConverter x:Key="ApprovedToTextConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:ModelSelectionConverter x:Key="ModelSelectionConverter"/>
        
        <!-- Suggested Prompt Button Style -->
        <Style x:Key="SuggestedPromptButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E1E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F3F3"/>
                    <Setter Property="BorderBrush" Value="#C1C1C1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- More Options Popup Menu -->
        <Popup x:Name="MoreOptionsPopup" 
               Placement="Bottom" 
               PlacementTarget="{Binding ElementName=MoreOptionsButton}"
               HorizontalOffset="-200"
               VerticalOffset="8"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White" 
                    BorderBrush="#E1E1E1" 
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="0"
                    Width="280">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" 
                                     Direction="315" 
                                     ShadowDepth="4" 
                                     Opacity="0.6" 
                                     BlurRadius="8"/>
                </Border.Effect>
                <StackPanel Margin="0">
                    <!-- Models Section -->
                    <StackPanel Margin="8,12,8,8">
                        <TextBlock Text="Models" 
                                  FontWeight="Bold" 
                                  FontSize="12" 
                                  Foreground="#333" 
                                  Margin="0,0,0,8"/>
                        
                        <!-- Auto (Selected) -->
                        <Button Background="Transparent" 
                                BorderThickness="0" 
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                Command="{Binding SelectModelCommand}"
                                CommandParameter="Auto"
                                Click="MenuItem_Click"
                                Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                          Text="✓" 
                                          FontSize="14" 
                                          Foreground="#10B981" 
                                          Margin="0,0,8,0"
                                          Visibility="{Binding SelectedModel, Converter={StaticResource ModelSelectionConverter}, ConverterParameter=Auto}"/>
                                <TextBlock Grid.Column="1" 
                                          Text="Auto" 
                                          FontSize="13" 
                                          Foreground="#333"/>
                                <TextBlock Grid.Column="2" 
                                          Text="▶" 
                                          FontSize="10" 
                                          Foreground="#999" 
                                          Opacity="0.5"/>
                            </Grid>
                        </Button>
                        
                        <!-- More -->
                        <Button Background="Transparent" 
                                BorderThickness="0" 
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                Click="MenuItem_Click"
                                Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" 
                                          Text="More" 
                                          FontSize="13" 
                                          Foreground="#333"/>
                                <TextBlock Grid.Column="2" 
                                          Text="▶" 
                                          FontSize="10" 
                                          Foreground="#999" 
                                          Opacity="0.5"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    
                    <!-- Divider -->
                    <Border Height="1" Background="#E1E1E1" Margin="8,4"/>
                    
                    <!-- Action Items Section -->
                    <StackPanel Margin="8,8">
                        <!-- Open in M365 Copilot app -->
                        <Button Background="Transparent" 
                                BorderThickness="0" 
                                HorizontalContentAlignment="Left"
                                Padding="8,8"
                                Command="{Binding OpenInAppCommand}"
                                Click="MenuItem_Click"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊞" 
                                          FontSize="14" 
                                          Foreground="#666" 
                                          Margin="0,0,12,0"/>
                                <TextBlock Text="Open in EPS Copilot app" 
                                          FontSize="13" 
                                          Foreground="#333"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Send feedback -->
                        <Button Background="Transparent" 
                                BorderThickness="0" 
                                HorizontalContentAlignment="Left"
                                Padding="8,8"
                                Command="{Binding SendFeedbackCommand}"
                                Click="MenuItem_Click"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" 
                                          FontSize="14" 
                                          Margin="0,0,12,0"/>
                                <TextBlock Text="Send feedback" 
                                          FontSize="13" 
                                          Foreground="#333"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Settings -->
                        <Button Background="Transparent" 
                                BorderThickness="0" 
                                HorizontalContentAlignment="Left"
                                Padding="8,8"
                                Command="{Binding OpenSettingsCommand}"
                                Click="MenuItem_Click"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" 
                                          FontSize="14" 
                                          Foreground="#666" 
                                          Margin="0,0,12,0"/>
                                <TextBlock Text="Settings" 
                                          FontSize="13" 
                                          Foreground="#333"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- New temporary chat -->
                        <Button Background="Transparent" 
                                BorderThickness="0" 
                                HorizontalContentAlignment="Left"
                                Padding="8,8"
                                Command="{Binding NewTemporaryChatCommand}"
                                Click="MenuItem_Click"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" 
                                          FontSize="14" 
                                          Margin="0,0,12,0"/>
                                <TextBlock Text="New temporary chat" 
                                          FontSize="13" 
                                          Foreground="#333"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Divider -->
                    <Border Height="1" Background="#E1E1E1" Margin="8,4"/>
                    
                    <!-- Upgrade Prompt Section -->
                    <Border Background="#F9F9F9" 
                            Padding="16,12" 
                            Margin="0">
                        <StackPanel>
                            <TextBlock Text="Go further with Copilot" 
                                      FontWeight="SemiBold" 
                                      FontSize="12" 
                                      Foreground="#333" 
                                      Margin="0,0,0,4"/>
                            <TextBlock Text="Access specialized agents, connect to work data, and more." 
                                      FontSize="11" 
                                      Foreground="#666" 
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,12"/>
                            <Button Content="Upgrade Copilot" 
                                    Background="White" 
                                    BorderBrush="#0078D4" 
                                    BorderThickness="1"
                                    Foreground="#0078D4"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Padding="12,6"
                                    HorizontalAlignment="Stretch"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                                <Setter Property="BorderBrush" Value="#005A9E"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Header - Microsoft Copilot Style -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left side: Menu and Shield icons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="☰" Width="32" Height="32" 
                            Background="Transparent" BorderThickness="0"
                            FontSize="16" Foreground="#333" 
                            ToolTip="Menu" Padding="0"/>
                    <Button Content="🛡" Width="32" Height="32" 
                            Background="Transparent" BorderThickness="0"
                            FontSize="16" Foreground="#333" 
                            ToolTip="Security" Padding="0" Margin="4,0,0,0"/>
                </StackPanel>
                
                <!-- Center: Copilot Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Copilot" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                    <TextBlock Text="Chat" FontSize="11" Foreground="#666" Margin="0,1,0,0"/>
                </StackPanel>
                
                <!-- Right side: Edit, More, Close icons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="✎" Width="32" Height="32" 
                            Background="Transparent" BorderThickness="0"
                            FontSize="16" Foreground="#333" 
                            ToolTip="Compose" Padding="0"/>
                    <Button x:Name="MoreOptionsButton" Width="32" Height="32" 
                            Background="Transparent" BorderThickness="0"
                            FontSize="18" Foreground="#333" 
                            ToolTip="More options" Padding="0" Margin="4,0,0,0"
                            Click="MoreOptionsButton_Click">
                        <Button.Content>
                            <TextBlock Text="⋯" FontSize="18"/>
                        </Button.Content>
                    </Button>
                    <Button Content="✕" Width="32" Height="32" 
                            Background="Transparent" BorderThickness="0"
                            FontSize="18" Foreground="#333" 
                            ToolTip="Close Copilot" Padding="0" Margin="4,0,0,0"
                            Command="{Binding CloseCopilotCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="MessageScrollViewer">
            <Grid>
                <!-- Welcome Screen (shown when no messages) -->
                <StackPanel Visibility="{Binding ShowWelcomeScreen, Converter={StaticResource BooleanToVisibilityConverter}}"
                           VerticalAlignment="Center" Margin="24,40">
                <TextBlock Text="Need help with your EPS data?" 
                          FontSize="24" FontWeight="SemiBold" 
                          Foreground="#333" 
                          TextAlignment="Center"
                          Margin="0,0,0,24"
                          TextWrapping="Wrap"/>
                
                <!-- Suggested Prompts -->
                <StackPanel Margin="0,0,0,16">
                    <Button Content="Show me all **business plans**"
                            Style="{StaticResource SuggestedPromptButtonStyle}"
                            Command="{Binding SelectSuggestedPromptCommand}"
                            CommandParameter="Show me all business plans">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#333">
                                    <Run Text="Show me all "/>
                                    <Run Text="business plans" Foreground="#0078D4" FontWeight="SemiBold"/>
                                </TextBlock>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    
                    <Button Content="Analyze **production forecast** for this project"
                            Style="{StaticResource SuggestedPromptButtonStyle}"
                            Command="{Binding SelectSuggestedPromptCommand}"
                            CommandParameter="Analyze production forecast for this project">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#333">
                                    <Run Text="Analyze "/>
                                    <Run Text="production forecast" Foreground="#0078D4" FontWeight="SemiBold"/>
                                    <Run Text=" for this project"/>
                                </TextBlock>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    
                    <Button Content="What are the **budget variances** this quarter?"
                            Style="{StaticResource SuggestedPromptButtonStyle}"
                            Command="{Binding SelectSuggestedPromptCommand}"
                            CommandParameter="What are the budget variances this quarter?">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#333">
                                    <Run Text="What are the "/>
                                    <Run Text="budget variances" Foreground="#0078D4" FontWeight="SemiBold"/>
                                    <Run Text=" this quarter?"/>
                                </TextBlock>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
                
                <Button HorizontalAlignment="Center"
                        Background="Transparent" 
                        BorderThickness="0"
                        Foreground="#0078D4"
                        FontSize="12"
                        Padding="0,4"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="See more" VerticalAlignment="Center"/>
                        <TextBlock Text=" ⌄" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                </StackPanel>

                <!-- Chat Messages (shown when messages exist) -->
                <ItemsControl ItemsSource="{Binding Messages}" 
                             Visibility="{Binding ShowWelcomeScreen, Converter={StaticResource InverseBooleanConverter}}"
                             Margin="0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F3F3F3"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="Margin" Value="8,8,40,8"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Sender}" Value="User">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Margin" Value="40,8,8,8"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Sender}" Value="System">
                                            <Setter Property="Background" Value="#FFF4E5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Content}" 
                                      TextWrapping="Wrap" 
                                      FontSize="13"
                                      Foreground="#333333">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sender}" Value="User">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Sender}" Value="System">
                                                <Setter Property="Foreground" Value="#663300"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loading Indicator -->
                <Border VerticalAlignment="Bottom" 
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="8,8,8,8" Background="#F3F3F3" 
                        Padding="12" CornerRadius="8" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" FontSize="16" Foreground="#0078D4" Margin="0,0,4,0">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1.0" To="0.3" Duration="0:0:0.5" 
                                                             AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                        <TextBlock Text="Thinking..." FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Input Area - Microsoft Copilot Style -->
        <Border Grid.Row="2" BorderBrush="#E1E1E1" BorderThickness="0,1,0,0" Background="White" Padding="16,12">
            <Grid>
                <!-- Message Copilot Input Field -->
                <Border BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="20" 
                        Background="#F3F3F3" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Plus Icon -->
                        <Button Grid.Column="0" Content="+" Width="24" Height="24" 
                                Background="Transparent" BorderThickness="0"
                                FontSize="18" Foreground="#666" 
                                Padding="0" Margin="0,0,8,0"/>
                        
                        <!-- Text Input -->
                        <Grid Grid.Column="1">
                            <TextBox x:Name="MessageTextBox"
                                     Text="{Binding UserMessage, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     MaxHeight="100"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     KeyDown="TextBox_KeyDown"/>
                            <TextBlock Text="Message Copilot" 
                                      Foreground="#999" 
                                      VerticalAlignment="Center"
                                      Margin="0,0,0,0"
                                      IsHitTestVisible="False"
                                      Visibility="{Binding ElementName=MessageTextBox, Path=Text, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </Grid>
                        
                        <!-- Settings/Filter Icon -->
                        <Button Grid.Column="2" Content="☰" Width="24" Height="24" 
                                Background="Transparent" BorderThickness="0"
                                FontSize="14" Foreground="#666" 
                                Padding="0" Margin="8,0,0,0"
                                ToolTip="Settings" RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </Button.RenderTransform>
                        </Button>
                        
                        <!-- Microphone Icon -->
                        <Button Grid.Column="3" Content="🎤" Width="24" Height="24" 
                                Background="Transparent" BorderThickness="0"
                                FontSize="16" Foreground="#666" 
                                Padding="0" Margin="8,0,0,0"
                                ToolTip="Voice input"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

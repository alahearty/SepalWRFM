<UserControl x:Class="SepalWRFM.Modules.WRFM.Views.SepalAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:converters="clr-namespace:SepalWRFM.Core.Converters;assembly=SepalWRFM.Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:IconKindConverter x:Key="IconKindConverter"/>
        
        <SolidColorBrush x:Key="SidebarBackground" Color="#FAF9F8"/>
        <SolidColorBrush x:Key="MainBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#323130"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8A8886"/>
        <SolidColorBrush x:Key="HoverBackground" Color="#F3F2F1"/>
        <SolidColorBrush x:Key="SelectedBackground" Color="#EDEBE9"/>
        <SolidColorBrush x:Key="BorderColor" Color="#EDEBE9"/>
        <SolidColorBrush x:Key="SelectedIndicator" Color="#0078D4"/>
        <SolidColorBrush x:Key="SidebarBorder" Color="#E1DFDD"/>
        <SolidColorBrush x:Key="AppCardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppCardBorder" Color="#EDEBE9"/>
        
        <Style x:Key="TemplateCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="280"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SelectedIndicator}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecentDocumentRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectedSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SelectedBackground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectedTabButtonStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource SelectedIndicator}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SelectedIndicator}"/>
        </Style>
    </UserControl.Resources>

           <Grid Background="{DynamicResource MainBackground}"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">
               <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="240"/>
                   <ColumnDefinition Width="*"/>
               </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Top Navigation Items -->
                <StackPanel Grid.Row="0">
                    <Button Style="{StaticResource SelectedSidebarButtonStyle}" Margin="8,16,8,4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Home" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Home" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Margin="8,4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentPlus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="New" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Margin="8,4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Open" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                <!-- Bottom Navigation Items (Account and Options) -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <Separator Margin="8,16,8,8"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Margin="8,4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Account" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Account" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Margin="8,4,8,16">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Options" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

               <!-- Main Content Area -->
               <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource MainBackground}"
                             UseLayoutRounding="True"
                             SnapsToDevicePixels="True">
                   <StackPanel Margin="32,32"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True">
                <!-- Greeting -->
                <TextBlock Text="{Binding Greeting}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,24"
                           TextOptions.TextFormattingMode="Display"/>

                <!-- WRFM Modules Section -->
                <TextBlock Text="WRFM Modules" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"
                           TextOptions.TextFormattingMode="Display"/>
                <TextBlock Text="Explore our comprehensive suite of Well &amp; Reservoir Field Management modules" 
                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"
                           TextOptions.TextFormattingMode="Display"/>
                <ItemsControl ItemsSource="{Binding WRFMModules}" Margin="0,0,0,32">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" 
                                       UseLayoutRounding="True" 
                                       SnapsToDevicePixels="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,12,12" Width="200" Height="240" 
                                        CornerRadius="8" 
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        Background="White"
                                        UseLayoutRounding="True"
                                        SnapsToDevicePixels="True"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        RenderOptions.EdgeMode="Aliased">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.12" Color="Black" RenderingBias="Quality"/>
                                    </Border.Effect>
                                    <Button Command="{Binding OpenCommand}" CommandParameter="{Binding}" 
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="130"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Gradient Background with Icon -->
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0" Height="130"
                                                    UseLayoutRounding="True"
                                                    SnapsToDevicePixels="True">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{Binding GradientStartColor.Color}" Offset="0"/>
                                                        <GradientStop Color="{Binding GradientEndColor.Color}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <!-- Decorative Circles Pattern -->
                                                    <Canvas>
                                                        <Ellipse Canvas.Left="100" Canvas.Top="12" Width="38" Height="38" 
                                                                 Fill="White" Opacity="0.1"
                                                                 UseLayoutRounding="True"
                                                                 SnapsToDevicePixels="True"/>
                                                        <Ellipse Canvas.Left="120" Canvas.Top="50" Width="26" Height="26" 
                                                                 Fill="White" Opacity="0.15"
                                                                 UseLayoutRounding="True"
                                                                 SnapsToDevicePixels="True"/>
                                                        <Ellipse Canvas.Left="35" Canvas.Top="60" Width="50" Height="50" 
                                                                 Fill="White" Opacity="0.08"
                                                                 UseLayoutRounding="True"
                                                                 SnapsToDevicePixels="True"/>
                                                        <Ellipse Canvas.Left="8" Canvas.Top="20" Width="22" Height="22" 
                                                                 Fill="White" Opacity="0.2"
                                                                 UseLayoutRounding="True"
                                                                 SnapsToDevicePixels="True"/>
                                                    </Canvas>
                                                    
                                                    <!-- Category Badge -->
                                                    <Border Background="White" Opacity="0.95" 
                                                            CornerRadius="10" Padding="6,3"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Margin="10,10,0,0">
                                                        <TextBlock Text="{Binding Category}" 
                                                                   FontSize="9" FontWeight="Bold"
                                                                   Foreground="{Binding GradientStartColor}"
                                                                   TextOptions.TextFormattingMode="Display"/>
                                                    </Border>
                                                    
                                                    <!-- Module Icon Container -->
                                                    <Border Background="White" Opacity="0.2" 
                                                            CornerRadius="30" Width="60" Height="60"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            UseLayoutRounding="True"
                                                            SnapsToDevicePixels="True">
                                                        <Viewbox Width="36" Height="36" 
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 UseLayoutRounding="True">
                                                            <materialDesign:PackIcon Kind="{Binding IconKind, Converter={StaticResource IconKindConverter}}" 
                                                                                     Foreground="White"/>
                                                        </Viewbox>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            
                                            <!-- Content Section -->
                                            <StackPanel Grid.Row="1" Margin="12,12" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="13" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextPrimary}" 
                                                           TextWrapping="Wrap" 
                                                           Margin="0,0,0,6"
                                                           LineHeight="17"
                                                           TextOptions.TextFormattingMode="Display"/>
                                                <TextBlock Text="{Binding Description}" 
                                                           FontSize="10" 
                                                           Foreground="{DynamicResource TextSecondary}" 
                                                           TextWrapping="Wrap"
                                                           LineHeight="15"
                                                           MaxHeight="42"
                                                           TextOptions.TextFormattingMode="Display"/>
                                                
                                                <!-- Action Indicator -->
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <TextBlock Text="Open Module" 
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding GradientStartColor}"
                                                               VerticalAlignment="Center"
                                                               TextOptions.TextFormattingMode="Display"/>
                                                    <materialDesign:PackIcon Kind="ChevronRight" 
                                                                             Width="12" Height="12"
                                                                             Foreground="{Binding GradientStartColor}"
                                                                             VerticalAlignment="Center"
                                                                             Margin="3,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- Hover Effect -->
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)" 
                                                                                     To="0.95" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)" 
                                                                                     To="1.0" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                <!-- More modules link -->
                <TextBlock Text="View all modules →" FontSize="14" FontWeight="SemiBold" 
                           Foreground="{DynamicResource SelectedIndicator}" Margin="0,0,0,32" Cursor="Hand">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Recent Section -->
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Tabs -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Recent" 
                                    Command="{Binding NavigateTabCommand}" CommandParameter="Recent">
                                <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="Recent">
                                                <Setter Property="Foreground" Value="{DynamicResource SelectedIndicator}"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SelectedIndicator}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Favorites" 
                                    Command="{Binding NavigateTabCommand}" CommandParameter="Favorites">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="Favorites">
                                                <Setter Property="Foreground" Value="{DynamicResource SelectedIndicator}"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SelectedIndicator}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Shared with Me" 
                                    Command="{Binding NavigateTabCommand}" CommandParameter="Shared">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="Shared">
                                                <Setter Property="Foreground" Value="{DynamicResource SelectedIndicator}"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SelectedIndicator}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="More documents →" FontSize="14" 
                                   Foreground="{DynamicResource SelectedIndicator}" VerticalAlignment="Center" Cursor="Hand">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Recent Documents Table -->
                    <Border Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Table Header -->
                            <Border Grid.Row="0" Background="{DynamicResource MainBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" Text="Date modified" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                </Grid>
                            </Border>

                            <!-- Table Rows -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentDocuments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border Style="{StaticResource RecentDocumentRowStyle}">
                                                <Button Command="{Binding OpenCommand}" CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        HorizontalContentAlignment="Stretch">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="200"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <Ellipse Fill="{Binding IconColor}">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <materialDesign:PackIcon Kind="FileDocument" 
                                                                                     Width="16" Height="16"
                                                                                     Foreground="White"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center"/>
                                                        </Grid>
                                                        
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" 
                                                                       Foreground="{DynamicResource TextPrimary}" 
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Location}" FontSize="12" 
                                                                       Foreground="{DynamicResource TextSecondary}" 
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        
                                                        <TextBlock Grid.Column="2" Text="{Binding DateModifiedText}" 
                                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" 
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                            </Border>
                                            <Separator Background="{DynamicResource BorderColor}" Margin="44,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Recover unsaved documents link -->
                    <TextBlock Text="Recover unsaved documents" FontSize="12" 
                               Foreground="{DynamicResource SelectedIndicator}" Margin="12,8,0,0" Cursor="Hand">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
